# Copy to .env (gitignored) and fill in the credentials of the docs test app.
STREAM_API_KEY=
STREAM_API_SECRET=
FIREBASE_CONFIG={} # optional
# Optional: Firebase service-account JSON for the push pages (single-quoted, may span lines).
# Without it, push tests are skipped (typecheck only). Push is never verified end-to-end.
FIREBASE_CONFIG=
